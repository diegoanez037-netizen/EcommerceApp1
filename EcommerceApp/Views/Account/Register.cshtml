@model EcommerceApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Catálogo";
}
<div class="auth-wrapper">
    <div class="auth-card">
        <h2 class="auth-title">Crea tu cuenta</h2>
        <p class="auth-subtitle">Regístrate para empezar a explorar Casa Andina.</p>

        <form asp-action="Register" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName">Nombre completo</label>
                <input asp-for="FullName" class="form-control" placeholder="Ej: Ramiro Vargas" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email">Correo electrónico</label>
                <input asp-for="Email" class="form-control" placeholder="tucorreo@ejemplo.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address">Dirección</label>
                <input asp-for="Address" class="form-control" placeholder="Ej: Av. América #123, Cochabamba" />
            </div>

            <button type="submit" class="btn btn-primary">Registrarme</button>
        </form>

        <div class="auth-footer-link">
            ¿Ya tienes cuenta? <a href="@Url.Action("Login")">Inicia sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}