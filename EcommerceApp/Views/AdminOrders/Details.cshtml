@model EcommerceApp.Models.Order
@using EcommerceApp.Models

@{
    ViewData["Title"] = "Detalle del pedido";
}

<div class="container py-5">

    <a asp-controller="AdminOrders"
       asp-action="Index"
       class="btn btn-link text-warning mb-4">
        ← Volver a pedidos
    </a>

    <div class="card p-4 mb-4">
        <h2 class="section-title">@Model.OrderNumber</h2>

        <p><strong>Cliente:</strong>
            @(Model.User?.FullName ?? Model.User?.Email ?? Model.UserId)
        </p>

        <p><strong>Fecha:</strong>
            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
        </p>

        <p><strong>Dirección:</strong>
            @(Model.ShippingAddress ?? "No indicada")
        </p>

        <form asp-action="UpdateStatus"
              asp-route-id="@Model.Id"
              method="post"
              class="mt-3">

            <label for="status">Cambiar estado</label>

            <select name="status"
                    id="status"
                    class="form-select my-2">

                @foreach (OrderStatus status in
                    Enum.GetValues<OrderStatus>())
                {
                    <option value="@status"
                            selected="@(status == Model.Status)">
                        @status
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-warning">
                Guardar estado
            </button>
        </form>
    </div>

    <div class="card p-4">
        <h3 class="section-title">Productos</h3>

        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var detail in Model.Details)
                {
                    <tr>
                        <td>@detail.ProductName</td>
                        <td>@detail.UnitPrice.ToString("N2") Bs</td>
                        <td>@detail.Quantity</td>
                        <td>@detail.Subtotal.ToString("N2") Bs</td>
                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <th colspan="3">Total</th>
                    <th>@Model.Total.ToString("N2") Bs</th>
                </tr>
            </tfoot>
        </table>
    </div>

</div>