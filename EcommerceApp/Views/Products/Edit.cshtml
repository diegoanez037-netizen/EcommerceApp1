@model EcommerceApp.Models.Product

@{
    ViewData["Title"] = "Catálogo";
}
<div class="form-page-wrapper">
    <div class="form-page-card">
        <h2 class="form-page-title">Editar bebida</h2>
        <p class="form-page-subtitle">Actualiza los datos de "@Model.Name".</p>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-group mb-3">
                <label asp-for="Name">Nombre</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description">Descripción</label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price">Precio (Bs)</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Stock">Stock (unidades disponibles)</label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl">Imagen (URL, opcional)</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Category">Categoría</label>
                <input asp-for="Category" class="form-control" />
            </div>

            <div class="form-page-actions">
                <button type="submit" class="btn-primary">Guardar cambios</button>
                <a href="@Url.Action("Index")" class="btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}