@{
    ViewData["Title"] = "Casa Andina";
}

<section class="hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="hero-title">
                Bebidas con <em>raíces</em>,<br>servicio sin fronteras.
            </h1>
            <p class="hero-sub">
                Casa Andina nació para conectar las mejores licorerías de Bolivia
                con quien sabe apreciar un buen trago, sin importar en qué ciudad esté.
            </p>
            <div class="hero-stats">
                <a asp-controller="Products" asp-action="Index" class="btn btn-agregar-bebida">
                    Ver catálogo
                </a>
            </div>
        </div>
    </div>
</section>

<h2 class="section-title">Nuestra promesa</h2>

<div class="row content-cards">
    <div class="col-md-4 mb-4">
        <div class="content-card">
            <h3>Origen verificado</h3>
            <p>Cada bebida que ves en el catálogo proviene de productores y distribuidores bolivianos reales.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="content-card">
            <h3>Stock transparente</h3>
            <p>Mostramos el inventario disponible en tiempo real, sin sorpresas al momento de comprar.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="content-card">
            <h3>Cobertura nacional</h3>
            <p>De La Paz a Santa Cruz, trabajamos para que cualquier licorería registrada pueda llegar a más clientes.</p>
        </div>
    </div>
</div>