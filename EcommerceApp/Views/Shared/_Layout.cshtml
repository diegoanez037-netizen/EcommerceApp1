@using Microsoft.AspNetCore.Identity
@using EcommerceApp.Data
@using EcommerceApp.Models
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Casa Andina</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%2315100C'/%3E%3Crect x='34' y='34' width='32' height='32' fill='%23C68F52' transform='rotate(45 50 50)'/%3E%3C/svg%3E">
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceApp.styles.css" asp-append-version="true" />
</head>
<body class="dark-theme">
    <header>
        <nav class="navbar navbar-expand-sm sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">Casa</span><span class="brand-mark-accent">Andina</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Report" asp-action="Catalogo" target="_blank">📄 Reporte</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @{
                            var cartCount = 0;
                            if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                try
                                {
                                    var uid = UserManager.GetUserId(User);
                                    cartCount = DbContext.CartItems.Count(c => c.UserId == uid);
                                }
                                catch
                                {
                                    cartCount = 0;
                                }
                            }
                        }

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link cart-icon-link" asp-controller="Cart" asp-action="Index">
                                    🛒 Carrito
                                    @if (cartCount > 0)
                                    {
                                        <span class="cart-badge">@cartCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link user-greeting">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn-plain">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-cta" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">Casa<em>Andina</em></div>
                    <p class="footer-tagline">
                        Bebidas seleccionadas de todo Bolivia, con la trazabilidad
                        y el cuidado de una licorería de barrio, al alcance de todo el país.
                    </p>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">NAVEGACIÓN</div>
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    <a asp-controller="Products" asp-action="Index">Catálogo</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
                <div class="footer-col">
                    <div class="footer-col-title">CUENTA</div>
                    <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                    <a asp-controller="Account" asp-action="Register">Registrarse</a>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; 2026 Casa Andina — Cochabamba, Bolivia
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>