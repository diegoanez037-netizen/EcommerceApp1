@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ha ocurrido un error al procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@{
    var exceptionFeature = Context.Features.Get<Microsoft.AspNetCore.Diagnostics.IExceptionHandlerPathFeature>();
}

@if (exceptionFeature?.Error != null)
{
    <div style="background-color: #2b1515; border: 1px solid #e74c3c; color: #fcc; padding: 1.2rem; border-radius: 6px; margin: 1.5rem 0;">
        <h3 style="color: #ff7675; margin-top: 0;">Detalle del error</h3>
        <p><strong>Ruta que falló:</strong> <code>@exceptionFeature.Path</code></p>
        <p><strong>Tipo de error:</strong> <code>@exceptionFeature.Error.GetType().FullName</code></p>
        <p><strong>Mensaje:</strong> @exceptionFeature.Error.Message</p>
        <details style="margin-top: 1rem;">
            <summary style="cursor: pointer; color: #fab1a0;">Ver traza completa (Stack Trace)</summary>
            <pre style="background-color: #1a0a0a; color: #fab1a0; padding: 1rem; border-radius: 4px; overflow-x: auto; margin-top: 0.5rem; font-size: 0.8rem; white-space: pre-wrap;">@exceptionFeature.Error.ToString()</pre>
        </details>
    </div>
}
