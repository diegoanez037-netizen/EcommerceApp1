@model EcommerceApp.Models.Order

@{
    ViewData["Title"] = "Detalle del pedido";
}

<div class="container py-5">

    <a asp-controller="Orders"
       asp-action="Index"
       class="btn btn-link text-warning mb-4">
        ← Volver a mis pedidos
    </a>

    <div class="card p-4 mb-4">
        <h2 class="section-title">Pedido @Model.OrderNumber</h2>

        <p>Fecha: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        <p>Estado: @Model.Status</p>
        <p>Dirección: @(Model.ShippingAddress ?? "No indicada")</p>
    </div>

    <div class="card p-4">
        <h3 class="section-title">Productos comprados</h3>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var detail in Model.Details)
                    {
                        <tr>
                            <td>@detail.ProductName</td>
                            <td>@detail.UnitPrice.ToString("N2") Bs</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.Subtotal.ToString("N2") Bs</td>
                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th colspan="3">Total</th>
                        <th>@Model.Total.ToString("N2") Bs</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>